+    await stuck.service.start();
+    await waitFor(() => passes >= 8);
+    await stuck.service.stop();
+    expect(persistent.messages.filter((message) => message.includes('[ingestion] embedding'))).toEqual([
+      '[ingestion] embedding left 4 chunk(s) stale for test-model:3; 5 failed pass(es), retrying with backoff',
+    ]);
+  });
