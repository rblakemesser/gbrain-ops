+  test('logs an embedding failure streak once without exception text and reports recovery', async () => {
+    const capture = captureLogger();
+    const secret = 'sk-do-not-log chunk body';
+    let embedCalls = 0;
+    const fx = harness({
+      logger: capture.logger,
+      embed: async () => {
+        embedCalls++;
+        if (embedCalls <= 3) {
+          throw Object.assign(new Error(secret), {
+            name: 'EmbeddingCredentialError',
+            diagnosis: { ok: false, reason: 'missing_env', missingEnvVars: ['ZEROENTROPY_API_KEY'] },
+          });
+        }
+      },
+    });
+
+    await fx.service.start();
+    await waitFor(() => capture.messages.some((message) => message.includes('recovered')));
+    const output = capture.messages.join('\n');
+    const failures = capture.messages.filter((message) => message.includes('embedding pass failed'));
+    expect(failures).toEqual([
+      '[ingestion] embedding pass failed (EmbeddingCredentialError missing_env ZEROENTROPY_API_KEY) '
+        + 'for test-model:3; 1 failed pass(es), retrying with backoff',
+    ]);
+    expect(output).toContain('[ingestion] embedding recovered after 3 failed pass(es)');
+    expect(output).not.toContain(secret);
+    expect((await fx.service.healthCheck()).last_embedding_error).toBeNull();
+    await fx.service.stop();
+  });
+
+  test('repeats a persistent embedding failure at most hourly', async () => {
