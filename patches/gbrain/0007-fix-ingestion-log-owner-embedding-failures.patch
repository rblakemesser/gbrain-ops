+    let embedCalls = 0;
+    const fx = harness({
+      logger: capture.logger,
+      now: () => clock,
+      sleep: async () => { clock += 10 * 60_000; },
+      embed: async (_engine, signal) => {
+        embedCalls++;
+        if (embedCalls > 13) {
+          await new Promise<void>((resolve) => signal.addEventListener('abort', () => resolve()));
+        }
+        throw new TypeError('fetch failed');
+      },
+    });
+
+    await fx.service.start();
+    await waitFor(() => embedCalls > 13);
+    await fx.service.stop();
+    const failures = capture.messages.filter((message) => message.includes('embedding pass failed'));
+    expect(failures.map((message) => message.match(/; (\d+) failed/)?.[1])).toEqual(['1', '7', '13']);
+    expect(failures[0]).toContain('(TypeError)');
+  });
+
