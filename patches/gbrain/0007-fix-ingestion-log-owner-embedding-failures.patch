+/**
+ * Name an embedding failure without its message text, which can carry
+ * provider responses or page content. Credential preflight errors expose
+ * their structured reason and the missing env var names.
+ */
+function describeEmbeddingError(error: unknown): string {
+  if (!(error instanceof Error)) return 'non-Error thrown';
+  const parts = [/^[A-Za-z0-9_]{1,64}$/.test(error.name) ? error.name : 'Error'];
+  const diagnosis = (error as { diagnosis?: unknown }).diagnosis;
+  if (diagnosis && typeof diagnosis === 'object') {
+    const { reason, missingEnvVars } = diagnosis as { reason?: unknown; missingEnvVars?: unknown };
+    if (typeof reason === 'string' && /^[a-z_]{1,64}$/.test(reason)) parts.push(reason);
+    if (Array.isArray(missingEnvVars)) {
+      parts.push(...missingEnvVars.filter(
+        (name): name is string => typeof name === 'string' && /^[A-Z][A-Z0-9_]{0,63}$/.test(name),
+      ));
+    }
+  }
+  const code = (error as { code?: unknown }).code;
+  if (typeof code === 'string' && /^[A-Za-z0-9_.-]{1,64}$/.test(code)) parts.push(`code=${code}`);
+  return parts.join(' ');
+}
+
+export const __testing = { mapPersistenceResult, describeEmbeddingError, BUILTIN_COMMAND_ARCHIVE };
